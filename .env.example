# 复制为 .env 后按宿主机修改。不要把 .env 提交到版本库。
IH_CONTAINER_NAME=icloudharbor
IH_CONFIG_PATH=./data/config
IH_PHOTOS_PATH=./data/photos
IH_PUID=1000
IH_PGID=1000
IH_UMASK=0022
IH_TIMEZONE=UTC

# 首次启动必须填写；程序会自动生成 config.yaml。
IH_APPLE_ID=your-account@example.com

# 以下变量留空时使用自动生成值或已有 config.yaml；仅适用于单账号部署。
IH_LOG_LEVEL=
IH_LOG_FORMAT=
IH_ACCOUNT_ID=
IH_ACCOUNT_NAME=
IH_REGION=
IH_DESTINATION=
IH_MOUNTED_MARKER=
IH_MINIMUM_FREE_SPACE=

IH_DOWNLOAD_PHOTOS=
IH_DOWNLOAD_VIDEOS=
IH_DOWNLOAD_LIVE_PHOTOS=
IH_PHOTO_VERSION=
IH_RAW_MODE=

# ISO 8601，例如 2026-07-18T00:00:00+08:00。
IH_CREATED_AFTER=
IH_CREATED_BEFORE=
IH_FAVORITES_ONLY=
IH_INCLUDE_HIDDEN=

IH_FOLDER_STRUCTURE=
IH_FILENAME_TEMPLATE=
IH_CONFLICT_POLICY=
IH_KEEP_UNICODE=

IH_SYNC_STRATEGY=
IH_FULL_SCAN_INTERVAL=
# IH_SCHEDULE 和 IH_SYNC_INTERVAL 只能设置一个。
IH_SCHEDULE=
IH_SYNC_INTERVAL=
IH_RUN_ON_START=

IH_DOWNLOAD_CONCURRENCY=
IH_CHUNK_SIZE=
IH_DOWNLOAD_TIMEOUT=
IH_MAX_RETRIES=
IH_VERIFY_HASH=
IH_KEEP_PARTIAL=

IH_NOTIFY_STARTUP=
IH_NOTIFY_SUCCESS=
IH_NOTIFY_NO_CHANGES=
IH_NOTIFY_FAILURE=
IH_NOTIFY_AUTH_REQUIRED=
