# iCloudHarbor 0.4.3 新手配置
# 复制为 .env 后逐项查看。开关只填 true（开启）或 false（关闭）。
# Apple 密码和验证码不要写在这里，首次认证会在终端安全询问。

# 必填：Apple Account 邮箱，同时直接作为默认账号 ID 和显示名称。
IH_APPLE_ID=your-account@example.com

# Docker 容器名与群晖路径。容器名供 docker logs/exec 使用，名称不冲突时无需修改。
# 群晖通常只需把路径改成 /volume... 并填写实际 UID/GID。
IH_CONTAINER_NAME=icloudharbor
IH_CONFIG_PATH=./data/config
IH_PHOTOS_PATH=./data/photos
IH_PUID=1000
IH_PGID=1000
IH_TIMEZONE=Asia/Shanghai

# iCloud 区域。auto 会自动识别；中国大陆账号认证失败时再改为 china。
IH_REGION=auto

# 同步频率：只能填 6、12、24，数字就是小时；推荐 12 或 24，默认 24。
# 6 小时请求更频繁，可能增加 Apple 限流或风控概率。
IH_SYNC_INTERVAL=24
# 容器每次启动后是否立即检查一次。推荐保持 true。
IH_RUN_ON_START=true

# 可选本地清理。开启后会读取 iCloud“最近删除”，仅删除数据库精确匹配且哈希未变化的本地文件。
# 不会删除 iCloud 内容；默认 false。首次开启前建议用 sync plan 临时传入 true 查看候选项。
IH_AUTO_DELETE=false

# 媒体开关。true=下载，false=跳过。
IH_DOWNLOAD_VIDEOS=true
IH_DOWNLOAD_LIVE_PHOTOS=true

# 可选功能。HEIC 转 JPEG 会额外生成文件；Synology 开关会触发 Photos 索引兼容处理。
IH_CONVERT_HEIC_TO_JPEG=false
IH_SYNOLOGY_PHOTOS_APP_FIX=false

# 可选筛选：删除行首 # 后生效。多个相册用英文逗号分隔。
# IH_DOWNLOAD_CONCURRENCY=1
# IH_ALBUMS=家庭,旅行
# IH_EXCLUDE_ALBUMS=屏幕快照
# IH_RECENT_ONLY=100

# 可选：企业微信应用通知。启用时前四项必须同时填写。
# IH_WECOM_ID=ww0000000000000000
# IH_WECOM_SECRET=your-enterprise-application-secret
# IH_WECOM_AGENT_ID=1000001
# IH_WECOM_TO_USER=@all
# IH_WECOM_PROXY=https://qyapi.weixin.qq.com
# IH_WECOM_CONTENT_SOURCE_URL=https://example.com
# IH_WECOM_NAME=iCloudHarbor
# MEDIA_ID_DOWNLOAD=your-download-media-id
# MEDIA_ID_STARTUP=your-startup-media-id
# MEDIA_ID_WARNING=your-warning-media-id
# MEDIA_ID_EXPIRATION=your-expiration-media-id
